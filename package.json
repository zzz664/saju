{
  "name": "saju",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@11.6.2",
  "engines": {
    "node": ">=24.0.0 <25",
    "npm": ">=11 <12"
  },
  "scripts": {
    "format": "prettier --write src scripts tests --log-level warn",
    "format:check": "prettier --check src scripts tests --log-level warn",
    "saju": "node --import tsx src/cli/main.ts",
    "dev": "next dev",
    "dev:api-test": "node scripts/api-test-dev.mjs",
    "build": "next build",
    "start": "next start",
    "test": "vitest run",
    "check:docs": "node scripts/check-doc-links.mjs",
    "test:watch": "vitest",
    "test:e2e": "node scripts/developer-e2e.mjs",
    "test:e2e:api-test": "node scripts/developer-e2e.mjs api-test",
    "test:e2e:core-qa": "node scripts/developer-e2e.mjs all",
    "test:e2e:security": "node scripts/developer-e2e.mjs security",
    "eval:persona": "node --env-file-if-exists=.env --env-file-if-exists=.env.local --import tsx tests/evaluation/run-persona-evaluation.ts",
    "typecheck": "next typegen && tsc --noEmit",
    "lint": "eslint . --max-warnings=0"
  },
  "dependencies": {
    "@js-temporal/polyfill": "0.5.1",
    "manseryeok": "2.0.0",
    "next": "16.4.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.2",
    "prettier": "3.9.10",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "5.0.5"
  }
}
