# v2.4: API 키는 서버 전용; R02/R03는 실제 스트리밍, PG는 테스트 전용.
# 공개 가능한 프로젝트 URL/공개 키. 실제 값은 git commit 금지.
NEXT_PUBLIC_SUPABASE_URL=https://example.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=replace-with-publishable-key

# 서버 전용. 앱 클라이언트에서 절대 참조/노출하지 않음.
SUPABASE_SECRET_KEY=server-only-replace
OPENAI_API_KEY=server-only-replace
OPENAI_MODEL=gpt-4o-mini

# PG는 테스트 환경 전용. 실제 키는 개발자센터 발급값 사용.
PAYMENT_MODE=test
PAYMENT_PROVIDER=toss_test
NEXT_PUBLIC_TOSS_CLIENT_KEY=test_ck_replace
TOSS_SECRET_KEY=test_sk_replace

# 특정 API 호출 경로의 완성 전 차단 스위치
ENABLE_TEST_PAYMENT=false
ENABLE_LIVE_PAYMENT=false
